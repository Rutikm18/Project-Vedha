# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://vapt:secret@localhost:5432/vapt_db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Neo4j (attack-path graph; optional — engine works in-memory without it) ────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j
NEO4J_ENABLED=false

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-at-least-32-chars-long!!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── AI engine — optional, Manager-owned ───────────────────────────────────────
# Only the Manager holds provider keys; the dashboard and probe never do.
# LLM_PROVIDER selects the provider. Leave it EMPTY to auto-detect the first
# configured cloud key in order: openai -> anthropic -> gemini -> openrouter
# (fails closed with a 503 if none is set). "ollama" is a local-dev opt-in and is
# never auto-selected. In production, set LLM_PROVIDER explicitly for determinism.
LLM_PROVIDER=ollama
# AI egress policy (see docs/adr/0003-bfsi-deployment-and-ai-gateway.md).
#   cloud     — raw context to the configured cloud provider (default)
#   hybrid    — cloud only after IPs/hostnames/e-mails/accounts are pseudonymized (BFSI default)
#   sovereign — local model only (LLM_PROVIDER=ollama); every cloud provider is refused
DEPLOYMENT_PROFILE=cloud
# Opt a cloud deployment into pseudonymization as well.
AI_PSEUDONYMIZE=false
# In-bank OpenAI-compatible model for DEPLOYMENT_PROFILE=sovereign (vLLM / TGI /
# LM Studio / Ollama /v1): set LLM_PROVIDER=local_openai. The URL must be internal
# (private IP, localhost, service name or internal DNS suffix) or it is refused.
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=
LOCAL_LLM_API_KEY=
# Offline intel bundles for air-gapped (sovereign) managers — see app/intel/bundle.py.
# Comma-separated base64 Ed25519 public keys trusted to sign bundles, and the
# writable dir the detection engine prefers over its packaged snapshots.
INTEL_BUNDLE_PUBLIC_KEYS=
VEDHA_INTEL_DIR=
LLM_REQUEST_TIMEOUT_SECONDS=180
LLM_MAX_TOKENS=4096          # raise if report narratives look truncated (ai.llm.truncated)
# Reasoning depth = thinking-token spend. Accepted by Sonnet 4.6 / Opus 4.6+ /
# Fable 5. Leave BLANK to omit it for models that reject effort (Sonnet 4.5 /
# Haiku 4.5). This replaced the old LLM_TEMPERATURE knob (temperature 400s on
# Opus 4.7/4.8 and Fable 5); no path sends temperature anymore.
LLM_EFFORT=low
LLM_MAX_RETRIES=5

# Ollama (local dev only; set LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# OpenRouter (set LLM_PROVIDER=openrouter). Set OPENROUTER_MODEL to a live ':free'
# model id — the literal 'openrouter/free' is not a real model and would 400.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Anthropic (set LLM_PROVIDER=anthropic). LLM_MODEL is the single Anthropic model
# the deployment serves; the assistant, report, and agent paths are all
# model-agnostic, so claude-opus-4-8 / claude-fable-5 work here as well.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# OpenAI (set LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (set LLM_PROVIDER=gemini). Key from aistudio.google.com/apikey.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
