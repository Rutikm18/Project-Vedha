# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://vapt:secret@localhost:5432/vapt_db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Neo4j (attack-path graph; optional — engine works in-memory without it) ────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j
NEO4J_ENABLED=false

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-at-least-32-chars-long!!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Manager-owned AI runtime — optional ───────────────────────────────────────
# The dashboard never receives provider credentials. Explicit Ollama is the
# local-development default in this example; production may select one cloud
# provider or leave LLM_PROVIDER empty to auto-detect a configured cloud key.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
LLM_REQUEST_TIMEOUT_SECONDS=180
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://vedha.local
OPENROUTER_APP_NAME=Vedha
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MAX_TOKENS=4096
LLM_EFFORT=low
LLM_MAX_RETRIES=5

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
