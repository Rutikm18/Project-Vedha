# Dockerfile.sealed — non-shipping research artifact for Nuitka packaging.
# Production uses ./Dockerfile; do not treat this as a deployment alternative
# until it passes the same release pipeline and runtime-parity tests.
# Multi-stage: build compiles to machine code; the runtime image carries just
# the executable. Combined with agent/license.py + agent/hw_bind.py this is
# the "sealed probe" — no Python, no bytecode, hardware-bound.
#
# Build:
#   docker build -f Dockerfile.sealed -t vedha-agent:sealed \
#     --build-arg PROBE_LICENSE_PUBKEY=<vendor pubkey hex> \
#     --build-arg HW_BIND_FINGERPRINT=<target machine fingerprint> \
#     --build-arg MTLS_CERT="$(cat path/to/mtls_cert.pem)" \
#     --build-arg MTLS_KEY="$(cat path/to/mtls_key.pem)" \
#     --build-arg MTLS_CA_CERT="$(cat path/to/ca_cert.pem)" .

# ── Stage 0: select exactly the agent's code ─────────────────────────────────
# The compiler is given the agent's import closure and nothing else — never
# scanner/findings.py (the judgement rules, which live on the manager), the
# campaign runner, accuracy gates, main_scripts/, cve/ or tests. --check fails
# the build if the agent ever imports one of those or uses a dynamic import.
FROM python:3.12-slim-bookworm AS select
WORKDIR /src
COPY . .
RUN python tools/agent_closure.py --check \
    && python tools/agent_closure.py --export /closure

# ── Stage 1: compile ──────────────────────────────────────────────────────────
# Pin to bookworm so the binary's glibc matches the bookworm runtime below.
FROM python:3.12-slim-bookworm AS build
WORKDIR /src

# build-essential (NOT bare gcc) — slim images lack libc headers (stdlib.h),
# which Nuitka's C backend needs. patchelf is required for --standalone.
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential patchelf ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Install Python deps: Nuitka + ALL of the probe's runtime deps. The deep-branch
# libraries (impacket, ldap3, dnspython) used to be missing here, so a sealed agent
# silently lost the SMB null-session, LDAP anonymous-bind and DNS zone-transfer
# checks (each branch raised "not installed" and degraded every assessment).
# `vedha-agent runtime-check` now fails the build if any of them is absent.
# Nuitka stays below 4.3, as in windows/build-agent-exe.ps1: 4.3 names the compiled
# main module after the entry file (agent/agent.py), which shadows the `agent`
# package, so the binary dies at startup with "'agent' is not a package"
# (Nuitka issue #4024).
COPY requirements-runtime.txt ./
RUN pip install --no-cache-dir "nuitka[onefile]<4.3" -r requirements-runtime.txt

COPY --from=select /closure/ ./

# ── Build args (embedded at compile time) ───────────────────────────────────
ARG PROBE_LICENSE_PUBKEY=""
ARG HW_BIND_FINGERPRINT=""
ARG MTLS_CERT=""
ARG MTLS_KEY=""
ARG MTLS_CA_CERT=""

# Compile the licence key + host fingerprint INTO the binary. They used to be
# runtime ENV, so `docker run -e LICENSE_ENFORCED=false` (or a self-made key
# pair) switched the licence off. agent/_sealed.py is regenerated here, before
# Nuitka runs; a sealed binary ignores those environment variables entirely.
COPY tools/write_sealed_consts.py ./tools/write_sealed_consts.py
RUN python3 tools/write_sealed_consts.py \
      --pubkey "${PROBE_LICENSE_PUBKEY}" --hw-fingerprint "${HW_BIND_FINGERPRINT}" && \
    grep -q "^SEALED = True" agent/_sealed.py

# Write mTLS certs (if provided) into the build context so Nuitka can embed them.
RUN if [ -n "${MTLS_CERT}" ]; then \
      echo "${MTLS_CERT}" > /src/agent/mtls_cert.pem; \
      echo "${MTLS_KEY}"  > /src/agent/mtls_key.pem; \
      echo "${MTLS_CA_CERT}" > /src/agent/ca_cert.pem; \
    fi

# Compile: all Python → C → machine code → single executable.
# Hardening for IP protection (verified: nothing in the probe reads __doc__ at
# runtime, so stripping docstrings is safe):
#   --lto=yes            link-time optimization — smaller + harder to analyze.
#                        NUITKA_LTO=no skips it: the link then takes minutes, not
#                        30+ on 2 cores. Module inclusion is decided before the C
#                        link, so seal-parity builds without it (seal_parity.sh).
#   no_docstrings        strips your algorithm explanations out of the binary
#   no_asserts           strips assert statements (they leak intent/invariants)
# HONEST NOTE: the FREE Nuitka still leaves string/number CONSTANTS (port lists,
# rule text) recoverable from the binary. To also encrypt constants + add
# anti-debugging, use Nuitka Commercial's protection plugin. Even so, this build
# already removes ALL source, bytecode, and docstrings — a large step up from
# shipping .py/.pyc (which decompile trivially).
ARG NUITKA_LTO=yes
RUN python3 -m nuitka --onefile --standalone --output-dir=/out \
      --output-filename=vedha-agent --follow-imports \
      --lto=${NUITKA_LTO} --python-flag=no_docstrings --python-flag=no_asserts \
      --include-package=scanner --include-package=workflow --include-package=agent \
      --include-package=cryptography --include-package=httpx \
      --include-package=websockets \
      --include-package=impacket --include-package=ldap3 --include-package=dns \
      --nofollow-import-to=paramiko --nofollow-import-to=winrm \
      --remove-output --assume-yes-for-downloads \
      agent/agent.py

# ── Stage 2: minimal runtime (binary only — no Python, no source) ─────────────
FROM debian:12-slim
WORKDIR /app
RUN groupadd --gid 10001 vedha && \
    useradd --no-log-init --uid 10001 --gid 10001 \
      --home-dir /nonexistent --shell /usr/sbin/nologin vedha && \
    mkdir -p /var/lib/vedha-agent && \
    # Update root CA certs so the binary can validate TLS (wss://, https://)
    apt-get update && apt-get install -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/* && \
    chown 10001:10001 /var/lib/vedha-agent

# Force UTF-8 — the probe uses Unicode characters in status messages.
ENV STATE_FILE=/var/lib/vedha-agent/state.json \
    RESULT_SPOOL_DIR=/var/lib/vedha-agent/spool \
    PYTHONIOENCODING=utf-8 \
    LANG=C.UTF-8

# No licence key / fingerprint ENV here: both are compiled into the binary
# (agent/_sealed.py) and the sealed gate ignores the environment.

COPY --from=build --chown=10001:10001 /out/vedha-agent /app/vedha-agent

# The binary starts itself — no python, no pip, no code.
USER 10001:10001
ENTRYPOINT ["/app/vedha-agent"]
CMD ["run"]
