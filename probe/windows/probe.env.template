# Vedha probe - Windows package config.
# The launchers (run.cmd and the service wrapper written by install.ps1) set
# these as environment variables. This file documents them and lets you change
# the defaults BEFORE packaging (package-zip.ps1 -Manager also overrides the URL).

# Manager API endpoint. A bare AWS testing box is http://<ip>:18080.
# For production use https://manager.your-domain.com (http sends the token in clear text).
PLATFORM_URL=http://13.127.147.205:18080

VERIFY_TLS=true

# Local scan CEILING (CIDR). Empty => the installer auto-detects this host's /24.
# Empty AND undetectable => the probe connects but the manager dispatches no jobs.
PROBE_NETWORK_SEGMENTS=

# State + spool live under C:\ProgramData\vedha-agent so the attended run and the
# background service share one identity.
# STATE_FILE=C:\ProgramData\vedha-agent\state.json
# RESULT_SPOOL_DIR=C:\ProgramData\vedha-agent\spool
