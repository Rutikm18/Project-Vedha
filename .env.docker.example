# Copy to .env (docker compose reads it automatically): cp .env.docker.example .env

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=vapt
POSTGRES_PASSWORD=secret
POSTGRES_DB=vapt_db
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PORT=6379

# ── API ───────────────────────────────────────────────────────────────────────
API_PORT=18080
# 2 suits a 2-vCPU test box. Each worker holds its own DB pool, so more workers
# = more Postgres connections. install.sh auto-sizes this from nproc for prod.
API_WORKERS=2
# development for local/testing (no TLS). Production deploys via
# deploy/aws/install.sh force APP_ENV=production + AUTH_COOKIE_SECURE=true.
APP_ENV=development
LOG_LEVEL=INFO
# CHANGE THIS — must be >= 32 chars. Generate: openssl rand -base64 48
JWT_SECRET=change-me-please-to-a-long-random-secret-value!!
# Local HTTP only. Set true when the dashboard is served through HTTPS (prod).
AUTH_COOKIE_SECURE=false

# Required by manager/docker-compose.yml (production stack).
# Generate: openssl rand -base64 32 | tr -d '\n'
# install.sh generates this automatically; only set manually for local prod testing.
PROBE_POLICY_SIGNING_KEY=

# Required by manager/docker-compose.yml (production stack).
# Local dev: http://localhost:3000 — production: https://app.your-domain.com
# Comma-separated list, no trailing slash.
CORS_ORIGINS=http://localhost:3000

# Required by manager/docker-compose.yml UI profile (frontend service).
# Local dev: http://localhost:18080 — production: https://api.your-domain.com
MANAGER_PUBLIC_URL=http://localhost:18080

# Build the API image with heavy integrations (AI/AD/Neo4j). 0 = lean (default).
INSTALL_EXTRAS=0

# ── First-run admin (seeded once by the `migrate` service) ────────────────────
SEED_ADMIN_EMAIL=admin@vedha.io
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_TENANT_NAME=Default Tenant

# ── Neo4j (only used with `--profile graph`) ──────────────────────────────────
NEO4J_ENABLED=false
NEO4J_USER=neo4j
NEO4J_PASSWORD=vedha-neo4j
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ── AI engine ─────────────────────────────────────────────────────────────────
# Empty = the automatic AI chain over every configured key (Claude first; see
# "Automatic AI chain" below). A value here is tried FIRST.
# Local model instead: set LLM_PROVIDER=ollama AND start Ollama — host-installed
# (OLLAMA_BASE_URL=http://host.docker.internal:11434) or `--profile local-ai`
# (OLLAMA_BASE_URL=http://ollama:11434). Never set it on a server without Ollama:
# every AI call would try it first.
LLM_PROVIDER=
# AI egress policy (see docs/adr/0003-bfsi-deployment-and-ai-gateway.md).
#   cloud     — raw context to the configured cloud provider (default)
#   hybrid    — cloud only after IPs/hostnames/e-mails/accounts are pseudonymized (BFSI default)
#   sovereign — local model only (LLM_PROVIDER=ollama); every cloud provider is refused
DEPLOYMENT_PROFILE=cloud
# Opt a cloud deployment into pseudonymization as well.
AI_PSEUDONYMIZE=false
# In-bank OpenAI-compatible model for DEPLOYMENT_PROFILE=sovereign (vLLM / TGI /
# LM Studio / Ollama /v1): set LLM_PROVIDER=local_openai. The URL must be internal
# (private IP, localhost, service name or internal DNS suffix) or it is refused.
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=
LOCAL_LLM_API_KEY=
# Offline intel bundles for air-gapped (sovereign) managers — see app/intel/bundle.py.
# Comma-separated base64 Ed25519 public keys trusted to sign bundles, and the
# writable dir the detection engine prefers over its packaged snapshots.
INTEL_BUNDLE_PUBLIC_KEYS=
VEDHA_INTEL_DIR=
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
LLM_REQUEST_TIMEOUT_SECONDS=180

# OpenRouter — also the automatic FREE fallback when a paid provider runs out of
# credit (OpenAI 429 / Anthropic "credit too low" cascade here). Get a free key at
# openrouter.ai/keys. OPENROUTER_MODEL must be a LIVE ':free' model id — the literal
# 'openrouter/free' is NOT a real model and 400s. Pick a current one from
# openrouter.ai/models?max_price=0 (they rotate). Instruct models emit cleaner JSON
# than reasoning models; the advisor forces JSON mode either way.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://vedha.local
OPENROUTER_APP_NAME=Vedha

# Backward-compatible Anthropic provider. Set LLM_PROVIDER=anthropic to use it.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# Optional OpenAI provider. Set LLM_PROVIDER=openai to use it. Requires an
# OpenAI account with active billing (a key alone returns HTTP 429 / insufficient_quota).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional Google Gemini provider. Set LLM_PROVIDER=gemini to use it. Uses the
# Generative Language `generateContent` API (not OpenAI-compatible). Get a key at
# aistudio.google.com/apikey — standard keys look like `AIza...` (an `AQ.`-prefixed
# value is likely a short-lived ephemeral/Live token and will expire).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# true only when the Gemini key's Google Cloud project has billing enabled. A free
# key may have its prompts used to improve Google's products, so Vedha always
# pseudonymizes what it sends to a free Gemini key.
GEMINI_PAID=false
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional Groq free tier (OpenAI-compatible, console.groq.com). Always pseudonymized.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ── Automatic AI chain (docs/adr/0004-ai-fallback-chain.md) ──────────────────
# Nobody picks a provider: every request walks this order and skips providers that
# are rate limited, out of credit, over their daily cap or down. Leave LLM_CHAIN
# empty for the default anthropic,openai,gemini,groq,openrouter (entries without a
# key are skipped). Local models join only when named here or in LLM_PROVIDER.
# NOTE: Claude Pro/Max and ChatGPT Plus subscriptions do NOT include API access —
# these must be API keys billed in the Anthropic Console / OpenAI platform.
LLM_CHAIN=
# Daily USD caps per provider; a capped provider steps aside until midnight IST.
#   AI_DAILY_CAP_USD=anthropic=20,openai=10
AI_DAILY_CAP_USD=
# Prices for models other than claude-sonnet-4-6 (USD per 1M tokens, in:out).
#   AI_MODEL_PRICES=gpt-4.1=2:8
AI_MODEL_PRICES=
# Reuse answers to byte-identical briefs/report sections for this long (0 = off).
AI_ANSWER_CACHE_TTL_SECONDS=604800

# ── Local probe (only used with `--profile probe`) ────────────────────────────
PROBE_NAME=local-probe
# Required when enabling the probe profile. Empty intentionally denies jobs.
PROBE_NETWORK_SEGMENTS=
PROBE_MAX_TARGETS=4096
PROBE_MAX_JOB_SECONDS=7200

# ── Image build knobs (all optional) ──────────────────────────────────────────
# API base image. Alpine is the default (smaller). If you see a musl-specific
# problem, or want ~20% faster pure-Python JSON work, use the Debian image:
# BACKEND_PYTHON_BASE=python:3.12-slim
# deploy/aws/install.sh: SERIAL_BUILD=1 builds one image at a time (tiny hosts),
# FORCE_REBUILD=1 rebuilds a release image that already exists,
# BUILD_CACHE_KEEP=3GB caps BuildKit's cache after a successful deploy.
# deploy/aws/install.sh: pull CI-built images instead of building on the instance.
# .github/workflows/images.yml pushes ghcr.io/<owner>/vedha-backend and
# vedha-frontend tagged with the commit. On the instance run once:
#   echo <token with read:packages> | docker login ghcr.io -u <user> --password-stdin
# then set (lowercase owner). A tag that is not there yet falls back to building.
# VEDHA_IMAGE_REGISTRY=ghcr.io/<owner>

# Metasploit RPC for the exploit engine (optional). Exploit routes answer 503 until a
# strong, non-default password is set; the stock "msf" is refused. msfrpcd uses a
# self-signed cert: point MSF_RPC_CA_BUNDLE at its CA, or set MSF_RPC_TLS_VERIFY=false
# to accept it knowingly.
MSF_RPC_HOST=127.0.0.1
MSF_RPC_PORT=55553
MSF_RPC_PASSWORD=
MSF_RPC_TLS_VERIFY=true
MSF_RPC_CA_BUNDLE=

# Outbound targets typed in by tenant admins (SIEM/EDR URLs, Jira, ServiceNow, Slack
# webhook, SMTP host). Loopback, link-local (the cloud metadata service) and reserved
# addresses are always refused. Private addresses are allowed by default because on-prem
# SIEM/Jira/mail servers live there; Slack and critical-webhook targets must be public.
# Strict mode: set OUTBOUND_ALLOW_PRIVATE_NETWORKS=false (https only, private refused) and
# name just the private hosts you need in OUTBOUND_HOST_ALLOWLIST (comma-separated).
OUTBOUND_ALLOW_PRIVATE_NETWORKS=true
OUTBOUND_HOST_ALLOWLIST=
