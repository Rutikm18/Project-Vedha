# expected.env — target + known-open services for the scan test harness.
#
# YOU fill this in. Each test_<scanner>.sh asserts against the EXPECT_* var
# relevant to it. If a var is unset, that script falls back to a "ran clean +
# reported something" check instead of a hard findings assertion.
#
# TARGET must be authorized for scanning. Ports are comma-separated.

# --- required ---------------------------------------------------------------
TARGET=192.168.1.0/24

# Default intensity when a script is run with no argument.
DEFAULT_LEVEL=T3

# --- known-open services (fill in what you're sure about) -------------------
EXPECT_PORTS=22,80,443,445      # port_scan / service_banner / mass_scan (fallback)

# Per-host expected ports (win over EXPECT_PORTS when the scanned target is a
# single host). Var name = EXPECT_PORTS_<ip with dots -> underscores>.
# Values below are what host_discovery actually observed on this LAN — edit to
# match your own hosts.
EXPECT_PORTS_192_168_1_68=445      # Windows box (445 open; 3389/135 need port_scan to confirm)
EXPECT_PORTS_192_168_1_254=22,80,443   # router / gateway
EXPECT_TLS=443                  # tls_scan
EXPECT_WEB=80,443               # web_scan
EXPECT_SMB=445                  # smb_scan
# EXPECT_UDP=161                # udp_scan
# EXPECT_SNMP=161               # snmp_scan
# EXPECT_DB=3306                # db_scan
# EXPECT_AI=                    # mcp_ai_scan (usually empty)
