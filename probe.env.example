# Probe config — copy to probe.env. Each Manager job carries engagement scope;
# PROBE_NETWORK_SEGMENTS below is an independent local authorization ceiling.

# Manager address (required)
PLATFORM_URL=http://localhost:18080

# Identity: production should use a manager-issued Personal Access Token (PAT)
# with probe:register plus the read/write scopes needed by the CLI.
# OPERATOR_TOKEN=vpat_xxx
# PROBE_PAT=vpat_xxx

# Display
PROBE_NAME=scanner-probe-01
PROBE_LOCATION=
# Required CIDR ceiling. The same list is advertised to the Manager for routing
# and independently enforced by the Probe before scanning. Empty denies all jobs.
PROBE_NETWORK_SEGMENTS=10.0.0.0/24

# Tuning
HEARTBEAT_INTERVAL=30
POLL_INTERVAL=10
JOB_LIMIT=1
# Hard appliance ceilings. Per-job values may reduce but never exceed these.
PROBE_MAX_TARGETS=4096
PROBE_MAX_JOB_SECONDS=7200

# Production licensing. The portable installer stores the signed token in the
# private state volume; do not put PROBE_LICENSE in this file.
# LICENSE_ENFORCED=true
# PROBE_LICENSE_FILE=/var/lib/vedha-agent/license.token
# PROBE_LICENSE_PUBKEY=<64-character-hex-public-key>

# ── Secure transport ─────────────────────────────────────────────────────────
# Use https:// in PLATFORM_URL for production — results and the agent token are
# otherwise sent in clear text. VERIFY_TLS must stay true unless the link is
# already trusted; set PROBE_CA_BUNDLE instead of disabling verification.
VERIFY_TLS=true
# Trust a private/self-signed manager CA (PEM path). Overrides the public trust store.
# PROBE_CA_BUNDLE=/etc/vedha/ca.pem
# mTLS: present a client certificate so the manager authenticates the probe at
# the TLS layer (generate with tools/gen_mtls_certs.sh). Both required together.
# PROBE_CLIENT_CERT=/etc/vedha/probe.crt
# PROBE_CLIENT_KEY=/etc/vedha/probe.key

# ── Result delivery durability ───────────────────────────────────────────────
# Results are spooled to disk (crash-safe, atomic) and retried until the manager
# returns 2xx; a lost ACK is deduplicated server-side (idempotent by job_id).
# RESULT_SPOOL_DIR=/var/lib/vedha-agent/spool
# gzip result payloads at/above this many bytes (default 1 MiB; 0 disables).
# RESULT_COMPRESS_OVER=1048576

# ── Local result archive (scan-accuracy review) ──────────────────────────────
# Every payload the probe submits is ALSO written to disk as
# result<UTC timestamp>.json, before it reaches the transport — so the file is
# what the manager receives, and you can audit a scan's accuracy on the probe
# host without going through the manager at all.
#
# This is not the delivery spool above: the spool deletes each file the moment
# upload succeeds, so a healthy probe leaves nothing to inspect. Nothing here is
# ever deleted by the probe — prune it yourself.
#
# Default: <probe root>/result (in the container image, /app/result — the
# container is read_only, so docker-compose.yml bind-mounts ./result there).
# Archiving is best-effort: if the path is unwritable the probe logs one warning
# and keeps submitting normally.
# PROBE_RESULT_DIR=/var/lib/vedha-agent/result
# Set it empty to turn archiving off entirely:
# PROBE_RESULT_DIR=
